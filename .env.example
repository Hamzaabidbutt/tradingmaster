# --- Database (MongoDB) ---
# Prisma's MongoDB connector needs a replica set — an Atlas cluster works,
# a standalone mongod does not. Schema changes ship via `npm run db:push`;
# there are no migrations on this connector.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/tradingmaster?retryWrites=true&w=majority&appName=Cluster0"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# --- Market data ---
# Binance USDT-M futures REST base (public market data, no API key required)
BINANCE_FAPI_BASE="https://fapi.binance.com"
BINANCE_WS_BASE="wss://fstream.binance.com"

# --- Signal engine ---
# Minimum confidence (0-100) required to persist/emit a signal
SIGNAL_MIN_CONFIDENCE="65"
# Worker loop interval in seconds
WORKER_INTERVAL_SEC="60"

# --- Confluence scanner ---
# Minimum confluence confidence (0-100) before a scan result becomes a LONG or
# SHORT decision. Below this the scanner returns NO_TRADE with a stated reason,
# so raising this makes the dashboard quieter, not emptier of explanation.
CONFLUENCE_MIN_CONFIDENCE="70"
# Timeframe the background worker sweeps the universe on. The web dashboard has
# its own 15m/1h/4h toggle and does not read this.
SCAN_TIMEFRAME="1h"
# Symbols the worker scans per tick. All ~530 perpetuals refresh every
# ceil(universe / SCAN_SLICE) ticks; larger slices mean fresher coverage and
# more Binance request weight per minute.
SCAN_SLICE="40"

# --- Alerts (all optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
GENERIC_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL_TO=""

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
