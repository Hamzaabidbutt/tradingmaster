# --- Database (MongoDB) ---
# Prisma's MongoDB connector needs a replica set — an Atlas cluster works,
# a standalone mongod does not. Schema changes ship via `npm run db:push`;
# there are no migrations on this connector.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/tradingmaster?retryWrites=true&w=majority&appName=Cluster0"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# --- Market data ---
# Binance USDT-M futures REST base (public market data, no API key required)
BINANCE_FAPI_BASE="https://fapi.binance.com"
BINANCE_WS_BASE="wss://fstream.binance.com"

# --- Signal engine ---
# Minimum confidence (0-100) required to persist/emit a signal
SIGNAL_MIN_CONFIDENCE="65"
# Worker loop interval in seconds
WORKER_INTERVAL_SEC="60"

# --- Confluence scanner ---
# Minimum confluence confidence (0-100) before a scan result becomes a LONG or
# SHORT decision. Below this the scanner returns NO_TRADE with a stated reason,
# so raising this makes the dashboard quieter, not emptier of explanation.
CONFLUENCE_MIN_CONFIDENCE="70"
# Timeframe the background worker sweeps the universe on. The web dashboard has
# its own 15m/1h/4h toggle and does not read this.
SCAN_TIMEFRAME="1h"
# Symbols the worker scans per tick. All ~530 perpetuals refresh every
# ceil(universe / SCAN_SLICE) ticks; larger slices mean fresher coverage and
# more Binance request weight per minute.
SCAN_SLICE="40"

# --- Alerts (all optional) ---
# Which alert kinds reach the channels below, comma-separated. Every channel is
# shared by every producer, so without this a phone set up for liquidation
# spikes also buzzes for each new signal and each closure.
#   signal.opened      a new composite-engine signal
#   signal.confluence  a new confluence-scanner signal
#   signal.closed      final target, stop or expiry
#   liqspike           forced flow at an extreme
#   setup.thrust       a change-of-character sequence arrived at its level
#   setup.ladder       consecutive candles started walking a straight line
# Unset = everything. Once set, untagged alerts are blocked too, so an
# allowlist stays an allowlist as new alert types are added.
ALERT_KINDS=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
GENERIC_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL_TO=""

# --- Setup alerts (retest & thrust, trendline ladders) ---
# Sweeps for the two setup scanners and pushes what clears the gate. Called on
# a schedule via /api/alerts/setups, guarded by CRON_SECRET. Nothing is sent
# until a channel above is configured.
#
# Sweep more often than the bar closes and you re-read the same closed candles
# at full Binance weight for no new information, so keep the schedule and the
# timeframe in step.
SETUP_ALERT_TIMEFRAME="1h"
SETUP_ALERT_DEPTH="80"
# Per symbol, so one coin cannot fill the channel by itself.
SETUP_ALERT_COOLDOWN_MIN="120"
# Hard cap per sweep, so a violent session cannot empty itself into a phone.
SETUP_ALERT_MAX_PER_RUN="5"
#
# Retest & thrust. Only `armed` setups alert — price at its level, expansion
# still ahead. Setups that have already expanded are deliberately never sent:
# the level is behind them, so the alert would be an invitation to chase.
SETUP_ALERT_THRUST_MIN_SCORE="3"
# The precedent filter is OFF by default (rate 0). Turning it on means deciding
# how much a measured frequency from one symbol's loaded window is worth, which
# is a judgement for whoever reads the alerts rather than for a default. When
# set, it applies only to symbols with at least MIN_PRECEDENT cases — a thin
# record is no record, not a bad one, and filtering on it would drop every
# symbol whose history is simply too short.
SETUP_ALERT_THRUST_MIN_BOOM_RATE="0"
SETUP_ALERT_THRUST_MIN_PRECEDENT="5"
#
# Trendline ladders. Straightness is 0-1; body is the share of bars closing in
# the run's own direction, which is what separates a drive from a grind.
SETUP_ALERT_LADDER_MIN_BARS="6"
SETUP_ALERT_LADDER_MIN_R2="0.9"
SETUP_ALERT_LADDER_MIN_BODY="0.5"

# --- Liquidation spike alerts ---
# Sweeps for forced flow printing at an extreme and pushes the ones that clear
# the gate to whatever channels above are configured. Nothing is sent until
# TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (or a Discord/webhook URL) is set.
#
# Timeframe the alert sweep reads. Spikes are detected on CLOSED candles, so
# this is also the alert's floor latency: on 5m an alert arrives up to one bar
# after the spike. Shorter is faster but noisier.
LIQ_ALERT_TIMEFRAME="5m"
# Symbols swept per run, ranked by 24h volume.
LIQ_ALERT_DEPTH="80"
# Minimum setup score (0-100). Raise to make the channel quieter.
LIQ_ALERT_MIN_SCORE="70"
# Reject spikes whose forced classification is "unlikely" (i.e. orderly bars).
LIQ_ALERT_REQUIRE_FORCED="true"
# Ignore spikes older than this many bars — the reversal has happened without you.
LIQ_ALERT_MAX_BARS_AGO="3"
# Minimum % already reversed off the spike extreme before it is worth sending.
LIQ_ALERT_MIN_REVERSAL_PCT="0.4"
# Hard cap per run, so one violent session cannot flood the channel.
LIQ_ALERT_MAX_PER_RUN="5"
# Minutes before the same symbol may alert again.
LIQ_ALERT_COOLDOWN_MIN="45"
# Worker-only: seconds between sweeps. 0 disables the worker's alert pass.
LIQ_ALERT_INTERVAL_SEC="300"

# Shared secret for /api/alerts/liquidations. The endpoint is DISABLED until
# this is set — an open endpoint that costs a universe sweep per call is a free
# denial-of-wallet. Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=""
# Base URL used to build the "open in terminal" link inside alerts.
APP_URL=""

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
