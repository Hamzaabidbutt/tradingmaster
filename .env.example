# --- Database (MySQL) ---
DATABASE_URL="mysql://trading:trading@localhost:3306/tradingmaster"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# --- Market data ---
# Binance USDT-M futures REST base (public market data, no API key required)
BINANCE_FAPI_BASE="https://fapi.binance.com"
BINANCE_WS_BASE="wss://fstream.binance.com"

# --- Signal engine ---
# Minimum confidence (0-100) required to persist/emit a signal
SIGNAL_MIN_CONFIDENCE="65"
# Worker loop interval in seconds
WORKER_INTERVAL_SEC="60"

# --- Alerts (all optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
GENERIC_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL_TO=""

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
